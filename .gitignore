__pycache__/
*.pyc
.venv/

# Node
node_modules/
dist/
client/dist/
server/dist/

# Runtime data - SQLite DB, uploaded resumes, JobRight session, debug dumps.
# /data/ is the container's DATA_DIR bind-mount target, /server/data/ the dev
# default. Both previously escaped this list, which is how a live production
# app.db ended up committed and blocking `git pull` on the NAS.
/data/*
!/data/.gitkeep
/server/data/

# Desktop/Mac app - removed from the build, kept here as an unused backup
.removed/
