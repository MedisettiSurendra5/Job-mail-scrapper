# Copy this file to .env and fill in real values. Never commit .env.

# jobright.ai login
JOBRIGHT_EMAIL=you@example.com
JOBRIGHT_PASSWORD="change-me"

# Gmail account that will SEND the outreach emails.
# You must use an App Password, not your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Path to the resume PDF that gets attached to every outreach email
# Quote the path if it contains spaces.
RESUME_PATH="resume.pdf"

# Search term and filters
SEARCH_TERM=data center technician

# Set to "true" to run the whole flow WITHOUT actually sending emails
# (still scrapes + logs to CSV). Good for checking selectors work
# before you fire real emails at real people.
DRY_RUN=true

# Stop the whole run once this many emails have been found/handled
# (sent, or would-be-sent in dry run). 0 = unlimited. Any job left
# mid-way is picked back up on the next run.
MAX_EMAILS=10

