# Copy to .env and fill in real values. .env is gitignored - never commit it.
#
# docker-compose.yml passes this whole file into the container via env_file,
# so anything missing here is silently missing in production too.

# --- Required. The server refuses to start without these. -------------------

# Signs the auth_token session cookie. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=

# AES-256-GCM key for credentials at rest (JobRight password, Gmail app
# passwords, Google refresh tokens). Generate with: openssl rand -hex 32
# Changing it makes every already-stored credential undecryptable.
ENCRYPTION_KEY=

# --- Shared JobRight login --------------------------------------------------
# Seeded into the JobRightConfig table on first boot only; after that the
# Admin page is the source of truth. Without it, Add Job fails with
# "The job search account has not been configured yet".
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=

# --- First admin account ----------------------------------------------------
# Created on first boot only, and only while no user exists yet. Change the
# password after logging in, then these two lines can be deleted.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Google OAuth ("Connect Gmail" on the Profile page) ---------------------
# Optional as a group: leave all three blank and members send via a Gmail
# address + app password instead. Setting only some of them is a boot error.
# See DEPLOY.md > "Connecting Google OAuth" for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. The callback URL is derived from the incoming request by
# default, which is correct on every origin the app is reachable at. Only set
# this if the public origin differs from the one reaching the server, and then
# it must match the Authorized redirect URI in the Cloud Console exactly:
# GOOGLE_REDIRECT_URI=https://jobvana.in/api/auth/google/callback

# --- Cloudflare Tunnel ------------------------------------------------------
# Token for the cloudflared sidecar in docker-compose.yml. Without it the
# tunnel container starts but never connects, and the public domain is down.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional tuning --------------------------------------------------------

# Port the server listens on. Defaults to 4000; the Cloudflare Tunnel's public
# hostname points at http://localhost:4000, so changing this means changing
# that too.
# PORT=4000

# Run Chromium with a visible window. Only useful locally when debugging the
# JobRight automation - must stay true (the default) on the NAS, which has no
# display.
# HEADLESS=true

# Where the SQLite DB, uploaded resumes, the JobRight session and the
# automation's debug screenshots live. docker-compose.yml overrides both of
# these to the in-container paths, so leave them unset here; locally they
# default to server/data.
# DATA_DIR=
# DATABASE_URL=
