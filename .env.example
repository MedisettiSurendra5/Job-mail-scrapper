# Copy this file to .env and fill in real values. Never commit .env.

# jobright.ai login - the one shared account used to browse/pull jobs.
# Only used to seed the login on first boot if nothing's been configured yet
# through the Admin page - safe to remove after initial setup.
JOBRIGHT_EMAIL=you@example.com
JOBRIGHT_PASSWORD="change-me"

# Port the Express server listens on.
PORT=4000

# Random secrets - generate with `openssl rand -hex 32`. Changing JWT_SECRET
# logs everyone out; changing ENCRYPTION_KEY makes existing encrypted
# secrets (Gmail app passwords, JobRight password) unreadable.
JWT_SECRET=change-me-to-a-random-64-char-hex-string
ENCRYPTION_KEY=change-me-to-a-different-random-64-char-hex-string

# Where the SQLite DB file, uploaded resumes, and the JobRight session live.
# Resolved to an absolute path automatically; DATABASE_URL is derived from
# it (don't set DATABASE_URL yourself here - it'll conflict).
DATA_DIR=./data

# Run Playwright headless (must be true in Docker/on the NAS).
HEADLESS=true

# One-time convenience seeding on first boot (only used if no users/JobRight
# config exist yet - safe to remove after initial setup):
SEED_ADMIN_EMAIL=medisettisurendra517@gmail.com
SEED_ADMIN_PASSWORD="sm##01SM"

# --- Optional: lets members use "Connect Gmail" in Profile (OAuth) instead
# of pasting an address + app password. Only needed if you want that feature;
# app-password sending keeps working without it. Create a Web application
# OAuth client at https://console.cloud.google.com/apis/credentials with the
# Gmail API enabled and this exact redirect URI registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Optional: exposing this to your domain via a Cloudflare Tunnel ---
# Only needed if you're using the cloudflared service in docker-compose.yml.
# Get this token from the Cloudflare Zero Trust dashboard when creating a
# tunnel (Networks > Tunnels > Create a tunnel > Docker). See DEPLOY.md.
CLOUDFLARE_TUNNEL_TOKEN=
